# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.cursor


# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Licensed brand fonts — served at runtime, never committed.
# This repo is public; the Graphik (Commercial Type) and TT Commons Pro
# (TypeType) EULAs cover serving from our own domain, not redistribution.
# Place the licensed web kits in public/fonts/ locally and upload them to
# the host as part of deploy.
/public/fonts/*.woff2
/public/fonts/*.woff
/public/fonts/Graphik-*
/public/fonts/TTCommonsPro-*

# Figma Dev Mode exports — reference material, not source. The README and the
# extracted design system are ours and do get committed.
/design/*
!/design/README.md
!/design/DESIGN-SYSTEM.md
